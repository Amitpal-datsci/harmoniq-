# ── Server-Side Secret Environment Variables (NEVER expose to client) ─────────
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://user:password@localhost:5432/harmoniq?schema=public"

# Google Gemini API Key for semantic summarization & live translations
GEMINI_API_KEY=""

# NextAuth / Auth.js secret for JWT encryption and session signing
AUTH_SECRET="harmonic-tactile-middleware-jwt-secret-key-32ch"
NEXTAUTH_SECRET="harmonic-tactile-middleware-jwt-secret-key-32ch"

# ── Public Client Environment Variables (Safe for browser bundles) ───────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
